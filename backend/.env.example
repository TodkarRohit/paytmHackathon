# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Atlas Connection URI
# Replace with your actual MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/paytm_sales?retryWrites=true&w=majority

# Client Application URL (for CORS)
CLIENT_URL=http://localhost:5173

# Google Gemini API Key (required for AI Sales Agent)
GEMINI_API_KEY=your_gemini_api_key_here

# JWT Signing Secret (required for secure authentication)
JWT_SECRET=your_jwt_secret_key_change_in_production

# Initial Operations Admin Credentials
ADMIN_EMAIL=admin@paytm-sales.local
ADMIN_INITIAL_PASSWORD=YourStrongAdminPassword@2026

# Twilio WhatsApp Integration
# Obtain from Twilio Console (https://console.twilio.com)
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
# Twilio WhatsApp Sender Number (e.g. sandbox whatsapp:+14155238886 or approved business number)
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886

# Dedicated Test Database URI (used for automated integration tests, never production data)
MONGODB_TEST_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/paytm_sales_test?retryWrites=true&w=majority


